cat > components/PosCart.tsx <<'EOF'
import React, { useState, useEffect } from 'react';

type Product = {
  id: string;
  name: string;
  priceSell: number;
  stock: number;
};

export default function PosCart() {
  const [query, setQuery] = useState('');
  const [results, setResults] = useState<Product[]>([]);
  const [cart, setCart] = useState<any[]>([]);

  useEffect(() => {
    if (!query) return setResults([]);
    const t = setTimeout(async () => {
      try {
        const res = await fetch(`/api/products?q=${encodeURIComponent(query)}&limit=8`);
        const json = await res.json();
        setResults(json || []);
      } catch (e) {
        console.error(e);
      }
    }, 200);
    return () => clearTimeout(t);
  }, [query]);

  function addProduct(p: Product) {
    setCart(prev => {
      const found = prev.find((x: any) => x.productId === p.id);
      if (found) return prev.map((x: any) => x.productId === p.id ? { ...x, quantity: x.quantity + 1 } : x);
      return [...prev, { productId: p.id, name: p.name, unitPrice: p.priceSell, quantity: 1 }];
    });
  }

  function calcTotals() {
    const subtotal = cart.reduce((s, it) => s + it.unitPrice * it.quantity, 0);
    const tax = parseFloat((subtotal * 0.12).toFixed(2));
    return { subtotal, tax, total: subtotal + tax };
  }

  async function checkout() {
    const payload = { items: cart.map(c => ({ productId: c.productId, quantity: c.quantity })), payments: [{ method: 'CASH', amount: calcTotals().total }] };
    const res = await fetch('/api/checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const json = await res.json();
    if (res.ok) {
      alert('Venta registrada: ' + json.sale?.id);
      setCart([]);
    } else {
      alert('Error: ' + json.error);
    }
  }

  const totals = calcTotals();

  return (
    <div className="p-4 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div className="md:col-span-2">
        <input value={query} onChange={e => setQuery(e.target.value)} placeholder="Buscar o escanear código" className="w-full p-3 rounded border" />
        <ul className="mt-3 space-y-2">
          {results.map(r => (
            <li key={r.id} className="p-3 border rounded flex justify-between items-center">
              <div>
                <div className="font-medium">{r.name}</div>
                <div className="text-sm text-gray-500">Stock: {r.stock}</div>
              </div>
              <div className="flex gap-2">
                <div className="text-right">${r.priceSell.toFixed(2)}</div>
                <button onClick={() => addProduct(r)} className="ml-3 bg-primary text-white px-3 py-1 rounded">Agregar</button>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div className="bg-white p-4 rounded shadow">
        <h3 className="font-semibold">Carrito</h3>
        <div className="mt-2 space-y-2 max-h-64 overflow-auto">
          {cart.map(it => (
            <div key={it.productId} className="flex justify-between">
              <div>{it.name} × {it.quantity}</div>
              <div>${(it.unitPrice * it.quantity).toFixed(2)}</div>
            </div>
          ))}
        </div>
        <div className="border-t mt-3 pt-3">
          <div className="flex justify-between"><span>Subtotal</span><span>${totals.subtotal.toFixed(2)}</span></div>
          <div className="flex justify-between"><span>IVA (12%)</span><span>${totals.tax.toFixed(2)}</span></div>
          <div className="flex justify-between font-bold"><span>Total</span><span>${totals.total.toFixed(2)}</span></div>
          <button onClick={checkout} className="mt-3 w-full bg-emerald text-white py-2 rounded">Pagar</button>
        </div>
      </div>
    </div>
  );
}
