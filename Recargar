cat > pages/api/checkout.ts <<'EOF'
import type { NextApiRequest, NextApiResponse } from 'next';
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL = process.env.SUPABASE_URL as string;
const SUPABASE_SERVICE_ROLE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY as string;

const supabaseAdmin = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, { auth: { persistSession: false } });

export default async function handler(req: NextApiRequest, res: NextApiResponse) {
  if (req.method !== 'POST') return res.status(405).end();
  const { items, payments, registerId } = req.body;
  if (!items || items.length === 0) return res.status(400).json({ error: 'No items provided' });

  try {
    let subtotal = 0;
    let tax = 0;

    for (const it of items) {
      const { data: product } = await supabaseAdmin.from('products').select('*').eq('id', it.productId).single();
      if (!product) throw new Error('Product not found: ' + it.productId);
      if (product.stock < it.quantity) throw new Error('Insufficient stock for ' + product.name);
      subtotal += parseFloat(product.price_sell) * it.quantity;
      tax += parseFloat(product.price_sell) * it.quantity * (product.tax_percent ?? 0) / 100;
    }

    const total = subtotal + tax;

    const { data: sale } = await supabaseAdmin.from('sales').insert([{ user_id: null, register_id: registerId, subtotal, tax_amount: tax, total_amount: total }]).select().single();

    for (const it of items) {
      await supabaseAdmin.from('sale_items').insert([{ sale_id: sale.id, product_id: it.productId, quantity: it.quantity, unit_price: it.unitPrice ?? 0 }]);
      await supabaseAdmin.rpc('decrement_stock', { p_product_id: it.productId, p_qty: it.quantity });
    }

    if (payments && payments.length) {
      for (const p of payments) {
        await supabaseAdmin.from('payments').insert([{ sale_id: sale.id, method: p.method, amount: p.amount, reference: p.reference || null }]);
      }
    }

    res.status(200).json({ sale });
  } catch (err: any) {
    console.error(err);
    res.status(400).json({ error: err.message || 'Error processing sale' });
  }
}
EOF

cat > pages/api/invoice/generate.ts <<'EOF'
import type { NextApiRequest, NextApiResponse } from 'next';
import PDFDocument from 'pdfkit';
import { createClient } from '@supabase/supabase-js';
import stream from 'stream';

const SUPABASE_URL = process.env.SUPABASE_URL as string;
const SUPABASE_SERVICE_ROLE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY as string;
const supabaseAdmin = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, { auth: { persistSession: false } });

export default async function handler(req: NextApiRequest, res: NextApiResponse) {
  if (req.method !== 'POST') return res.status(405).end();
  const { saleId } = req.body;
  if (!saleId) return res.status(400).json({ error: 'Missing saleId' });

  try {
    const { data: sale } = await supabaseAdmin.from('sales').select('*, items: sale_items(*), payments(*)').eq('id', saleId).single();
    if (!sale) return res.status(404).json({ error: 'Sale not found' });

    const doc = new PDFDocument({ margin: 40, size: 'A4' });
    const passThrough = new stream.PassThrough();
    doc.pipe(passThrough);

    doc.fontSize(16).text('RecargasFree - Factura', { align: 'center' });
    doc.moveDown();
    doc.text(\`Venta: \${sale.id}\`);
    doc.text(\`Fecha: \${new Date(sale.created_at).toLocaleString()}\`);
    doc.moveDown();

    (sale.items || []).forEach((it: any) => {
      doc.text(\`\${it.quantity} x \${it.unit_price.toFixed(2)}  \${ (it.quantity * it.unit_price).toFixed(2) }\`);
    });

    doc.moveDown();
    doc.text(\`Subtotal: \${sale.subtotal.toFixed(2)}\`);
    doc.text(\`IVA: \${sale.tax_amount.toFixed(2)}\`);
    doc.text(\`Total: \${sale.total_amount.toFixed(2)}\`);
    doc.end();

    const buffers: Buffer[] = [];
    passThrough.on('data', chunk => buffers.push(Buffer.from(chunk)));
    passThrough.on('end', async () => {
      const fileBuffer = Buffer.concat(buffers);
      const fileName = \`invoices/\${saleId}.pdf\`;
      const { data, error } = await supabaseAdmin.storage.from('invoices').upload(fileName, fileBuffer, { contentType: 'application/pdf', upsert: true });
      if (error) throw error;
      const { publicUrl } = supabaseAdmin.storage.from('invoices').getPublicUrl(fileName);
      await supabaseAdmin.from('invoices').insert([{ sale_id: saleId, invoice_number: \`INV-\${saleId}\`, pdf_url: publicUrl }]);
      res.status(200).json({ url: publicUrl });
    });

  } catch (err: any) {
    console.error(err);
    res.status(500).json({ error: err.message || 'Error generating invoice' });
  }
}
EOF

cat > db/schema.sql <<'EOF'
-- Schema SQL for Supabase / Postgres

-- Users table (Supabase provides auth; this is optional for profile extension)
CREATE TABLE IF NOT EXISTS users_profiles (
  id uuid PRIMARY KEY,
  email text UNIQUE,
  name text,
  role text DEFAULT 'CASHIER',
  created_at timestamptz DEFAULT now()
);

-- Products
CREATE TABLE IF NOT EXISTS products (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  sku text UNIQUE,
  name text NOT NULL,
  description text,
  price_sell numeric(12,2) NOT NULL DEFAULT 0,
  price_cost numeric(12,2) DEFAULT 0,
  tax_percent numeric(5,2) DEFAULT 0,
  stock integer DEFAULT 0,
  stock_min integer DEFAULT 0,
  barcode text UNIQUE,
  image_url text,
  created_at timestamptz DEFAULT now()
);

-- Sales
CREATE TABLE IF NOT EXISTS sales (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid,
  register_id uuid,
  subtotal numeric(12,2) DEFAULT 0,
  tax_amount numeric(12,2) DEFAULT 0,
  discount numeric(12,2) DEFAULT 0,
  total_amount numeric(12,2) DEFAULT 0,
  created_at timestamptz DEFAULT now()
);

-- Sale items
CREATE TABLE IF NOT EXISTS sale_items (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  sale_id uuid REFERENCES sales(id) ON DELETE CASCADE,
  product_id uuid REFERENCES products(id),
  quantity integer NOT NULL,
  unit_price numeric(12,2) NOT NULL,
  total_line numeric(12,2) NOT NULL
);

-- Payments
CREATE TABLE IF NOT EXISTS payments (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  sale_id uuid REFERENCES sales(id) ON DELETE CASCADE,
  method text,
  amount numeric(12,2),
  reference text
);

-- Invoices
CREATE TABLE IF NOT EXISTS invoices (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  sale_id uuid UNIQUE REFERENCES sales(id),
  invoice_number text UNIQUE,
  pdf_url text,
  created_at timestamptz DEFAULT now()
);

-- Helper RPC to decrement stock safely (uses FOR UPDATE)
CREATE OR REPLACE FUNCTION decrement_stock(p_product_id uuid, p_qty integer) RETURNS void AS $$
BEGIN
  UPDATE products SET stock = stock - p_qty WHERE id = p_product_id;
END;
$$ LANGUAGE plpgsql VOLATILE;
EOF

